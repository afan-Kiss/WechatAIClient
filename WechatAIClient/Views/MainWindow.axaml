<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WechatAIClient.ViewModels"
        xmlns:models="using:WechatAIClient.Models"
        xmlns:controls="using:WechatAIClient.Controls"
        x:Class="WechatAIClient.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1440"
        Height="900"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        Title="微信AI聊天助手"
        KeyDown="Window_OnKeyDown">

  <Border x:Name="RootChrome"
          Background="{DynamicResource WindowBackgroundBrush}"
          CornerRadius="12"
          ClipToBounds="True"
          BorderBrush="{DynamicResource GlassBorderBrush}"
          BorderThickness="1">
    <Grid RowDefinitions="40,*">

      <!-- Title bar -->
      <Border Grid.Row="0"
              Background="{DynamicResource TitleBarBrush}"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,0,1"
              PointerPressed="TitleBar_OnPointerPressed">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,0">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource AccentGradientBrush}">
              <TextBlock Text="✦" Foreground="White" FontSize="12"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="微信AI聊天助手"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Classes="chrome-button" Click="Minimize_OnClick" ToolTip.Tip="最小化">
              <TextBlock Text="─" FontSize="12" HorizontalAlignment="Center" />
            </Button>
            <Button Classes="chrome-button" Click="Maximize_OnClick" ToolTip.Tip="最大化">
              <TextBlock Text="□" FontSize="12" HorizontalAlignment="Center" />
            </Button>
            <Button Classes="chrome-button chrome-close" Click="Close_OnClick" ToolTip.Tip="关闭">
              <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Body -->
      <Grid x:Name="BodyMargin" Grid.Row="1" Margin="12">
        <Grid ColumnDefinitions="Auto,*,Auto">

          <!-- Left: contacts -->
          <controls:GlassCard Grid.Column="0"
                              Width="300"
                              MinWidth="240"
                              MaxWidth="320"
                              ContentPadding="12"
                              Margin="0,0,8,0"
                              HorizontalAlignment="Left">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
              <Button Classes="glass-button"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,8"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleAccountMenuCommand}"
                      Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AccountSwitcherText}" />
              <Popup IsOpen="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsAccountMenuOpen, Mode=TwoWay}"
                     Placement="Bottom"
                     PlacementTarget="{Binding $parent}"
                     IsLightDismissEnabled="True">
                <Border Background="{DynamicResource PanelElevatedBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="6"
                        MinWidth="200">
                  <ItemsControl ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AccountMenuItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AccountMenuItem">
                        <Button Classes="segment"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectAccountMenuItemCommand}"
                                CommandParameter="{Binding}">
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subtitle}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </Popup>

              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" DataContext="{Binding ContactList}">
                <TextBox Classes="search-box"
                         Text="{Binding SearchText}"
                         PlaceholderText="搜索联系人或群聊"
                         MinWidth="0" />
                <Border x:Name="ShortcutChip"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="8,0"
                        CornerRadius="8"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Stretch"
                        IsVisible="True">
                  <TextBlock Text="Ctrl + K"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="11"
                             VerticalAlignment="Center" />
                </Border>
              </Grid>

              <Border Grid.Row="2" Margin="0,12,0,12" Padding="4" CornerRadius="10"
                      Background="{DynamicResource InputBackgroundBrush}"
                      DataContext="{Binding ContactList}">
                <Grid ColumnDefinitions="*,*,*">
                  <Button Classes="segment" Classes.active="{Binding IsRecentTab}"
                          Command="{Binding SelectTabCommand}" CommandParameter="0"
                          Content="最近聊天" HorizontalAlignment="Stretch" />
                  <Button Grid.Column="1" Classes="segment" Classes.active="{Binding IsFriendsTab}"
                          Command="{Binding SelectTabCommand}" CommandParameter="1"
                          Content="好友" HorizontalAlignment="Stretch" />
                  <Button Grid.Column="2" Classes="segment" Classes.active="{Binding IsGroupsTab}"
                          Command="{Binding SelectTabCommand}" CommandParameter="2"
                          Content="群聊" HorizontalAlignment="Stretch" />
                </Grid>
              </Border>

              <ListBox Grid.Row="3"
                       Classes="contact-list"
                       DataContext="{Binding ContactList}"
                       ItemsSource="{Binding VisibleContacts}"
                       SelectedItem="{Binding SelectedContact}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:Contact">
                    <Border Classes="contact-item">
                      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                        <controls:Avatar Grid.RowSpan="2"
                                         Initials="{Binding AvatarInitials}"
                                         AvatarBackground="{Binding AvatarColor, Converter={StaticResource StringToBrushConverter}}"
                                         ImagePath="{Binding AvatarLocalPath}"
                                         Size="44"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" MinWidth="0">
                          <TextBlock Text="{Binding Name}"
                                     Foreground="{DynamicResource TextBrush}"
                                     FontWeight="SemiBold"
                                     FontSize="14"
                                     MinWidth="0"
                                     TextTrimming="CharacterEllipsis"
                                     TextWrapping="NoWrap" />
                          <TextBlock Text="{Binding AccountDisplayName}"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     FontSize="10"
                                     TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsAggregateAccountView}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding LastMessageTime, Converter={StaticResource TimeDisplayConverter}}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,4,8,0"
                                   Text="{Binding LastMessage}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   MinWidth="0"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <Border Grid.Row="1"
                                Grid.Column="2"
                                IsVisible="{Binding UnreadCount, Converter={StaticResource GreaterThanZeroConverter}}"
                                Background="{DynamicResource DangerBrush}"
                                CornerRadius="9"
                                MinWidth="18"
                                Height="18"
                                Padding="5,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding UnreadDisplay}"
                                     Foreground="White"
                                     FontSize="10"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <!-- WeChat connection status -->
              <Border Grid.Row="4"
                      Margin="0,8,0,0"
                      Padding="8,6"
                      CornerRadius="10"
                      Background="{DynamicResource InputBackgroundBrush}"
                      DataContext="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext)}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding WechatStatusText}"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Button Grid.Column="1"
                          Classes="glass-button"
                          Padding="8,3"
                          FontSize="10"
                          Content="重连"
                          Command="{Binding ReconnectWechatCommand}" />
                </Grid>
              </Border>

              <!-- Bottom nav: bind to MainWindow VM (not ContactList) -->
              <Border Grid.Row="5"
                      Margin="0,10,0,0"
                      Padding="6"
                      CornerRadius="12"
                      Background="{DynamicResource InputBackgroundBrush}"
                      DataContext="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext)}">
                <Grid ColumnDefinitions="*,*">
                  <Button Classes="nav-icon"
                          Classes.active="{Binding IsChatNav}"
                          Command="{Binding SelectNavCommand}"
                          CommandParameter="0"
                          Content="💬"
                          ToolTip.Tip="聊天" />
                  <Button Grid.Column="1"
                          Classes="nav-icon"
                          Classes.active="{Binding IsSettingsNav}"
                          Command="{Binding ToggleSettingsCommand}"
                          Content="⚙"
                          ToolTip.Tip="设置" />
                </Grid>
              </Border>
            </Grid>
          </controls:GlassCard>

          <!-- Center: chat / favorites -->
          <Grid Grid.Column="1" Margin="0,0,8,0">
            <!-- Chat -->
            <controls:GlassCard ContentPadding="0"
                                IsVisible="{Binding !IsFavoritesVisible}">
              <Grid RowDefinitions="64,*,Auto" DataContext="{Binding Chat}">
                <!-- Header -->
                <Border Grid.Row="0"
                        Padding="16,0"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <controls:Avatar Grid.Column="0"
                                     Initials="{Binding CurrentContact.AvatarInitials}"
                                     AvatarBackground="{Binding CurrentContact.AvatarColor, Converter={StaticResource StringToBrushConverter}}"
                                     ImagePath="{Binding CurrentContact.AvatarLocalPath}"
                                     Size="40"
                                     VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Margin="12,0,8,0"
                                MinWidth="0"
                                VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding CurrentContact.Name}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   MinWidth="0"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding CurrentContact.MemberCount, StringFormat='({0})'}"
                                   IsVisible="{Binding CurrentContact.MemberCount, Converter={StaticResource GreaterThanZeroConverter}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="● 在线"
                                 FontSize="12"
                                 Foreground="{DynamicResource SuccessBrush}"
                                 IsVisible="{Binding CurrentContact.IsOnline}" />
                      <TextBlock Text="○ 离线"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 IsVisible="{Binding !CurrentContact.IsOnline}" />
                    </StackPanel>
                    <!-- 电话/视频/更多/搜索假按钮已移除 -->
                  </Grid>
                </Border>

                <!-- Messages -->
                <ScrollViewer x:Name="MessageScrollViewer" Grid.Row="1" Padding="18,12">
                  <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:ChatMessage">
                        <StackPanel>
                          <TextBlock Text="{Binding TimeSeparatorText}"
                                     IsVisible="{Binding ShowTimeSeparator}"
                                     HorizontalAlignment="Center"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     FontSize="12"
                                     Margin="0,8,0,8"
                                     TextWrapping="Wrap" />
                          <DockPanel LastChildFill="True">
                            <controls:Avatar DockPanel.Dock="Left"
                                             IsVisible="{Binding !IsSelf}"
                                             Initials="{Binding SenderInitials}"
                                             AvatarBackground="{Binding SenderAvatarColor, Converter={StaticResource StringToBrushConverter}}"
                                             ImagePath="{Binding SenderAvatarPath}"
                                             Size="34"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Top" />
                            <controls:Avatar DockPanel.Dock="Right"
                                             IsVisible="{Binding IsSelf}"
                                             Initials="{Binding SenderInitials}"
                                             AvatarBackground="{Binding SenderAvatarColor, Converter={StaticResource StringToBrushConverter}}"
                                             ImagePath="{Binding SenderAvatarPath}"
                                             Size="34"
                                             Margin="10,0,0,0"
                                             VerticalAlignment="Top" />
                            <StackPanel HorizontalAlignment="{Binding IsSelf, Converter={StaticResource BoolToHorizontalAlignmentConverter}}"
                                        MaxWidth="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Chat.BubbleMaxWidth}">
                              <TextBlock Text="{Binding SenderName}"
                                         IsVisible="{Binding !IsSelf}"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         FontSize="11"
                                         Margin="4,0,0,4"
                                         TextTrimming="CharacterEllipsis" />
                              <Panel>
                                <controls:ChatBubble IsSelf="{Binding IsSelf}">
                                  <controls:ChatBubble.ContextMenu>
                                    <ContextMenu>
                                      <MenuItem Header="📌 固定为 AI 参考"
                                                IsVisible="{Binding !IsPinned}"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Chat.PinMessageCommand}"
                                                CommandParameter="{Binding}" />
                                      <MenuItem Header="📌 取消固定"
                                                IsVisible="{Binding IsPinned}"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Chat.UnpinMessageCommand}"
                                                CommandParameter="{Binding}" />
                                    </ContextMenu>
                                  </controls:ChatBubble.ContextMenu>
                                  <StackPanel Spacing="8">
                                    <TextBlock Text="📌"
                                               FontSize="10"
                                               Opacity="0.7"
                                               HorizontalAlignment="Right"
                                               IsVisible="{Binding IsPinned}"
                                               Margin="0,0,0,-4" />
                                    <Border IsVisible="{Binding Type, Converter={StaticResource MessageTypeEqualsConverter}, ConverterParameter=Quote}"
                                            Background="{DynamicResource QuoteBackgroundBrush}"
                                            CornerRadius="8"
                                            Padding="8">
                                      <StackPanel>
                                        <TextBlock Text="{Binding QuoteSender}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding QuoteContent}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                      </StackPanel>
                                    </Border>

                                    <Border IsVisible="{Binding Type, Converter={StaticResource MessageTypeEqualsConverter}, ConverterParameter=Image}"
                                            MaxWidth="320"
                                            MaxHeight="300"
                                            CornerRadius="10"
                                            ClipToBounds="True"
                                            Background="{DynamicResource QuoteBackgroundBrush}">
                                      <Panel>
                                        <TextBlock Text="图片加载中…"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="24"
                                                   IsVisible="{Binding IsMediaLoading}" />
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="6"
                                                    Margin="16"
                                                    IsVisible="{Binding IsMediaFailed}">
                                          <TextBlock Text="图片加载失败"
                                                     Foreground="{DynamicResource TextMutedBrush}"
                                                     HorizontalAlignment="Center" />
                                          <TextBlock Text="加载失败，可稍后重试"
                                                     FontSize="11"
                                                     Foreground="{DynamicResource TextMutedBrush}"
                                                     HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <controls:MediaImage Path="{Binding ResolvedMediaPath}"
                                                             MaxWidth="320"
                                                             MaxHeight="300"
                                                             Stretch="Uniform"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             IsVisible="{Binding IsMediaLoaded}" />
                                      </Panel>
                                    </Border>

                                    <Border IsVisible="{Binding Type, Converter={StaticResource MessageTypeEqualsConverter}, ConverterParameter=Emoji}"
                                            MaxWidth="160"
                                            MaxHeight="160"
                                            CornerRadius="8">
                                      <Panel>
                                        <TextBlock Text="【表情消息】"
                                                   IsVisible="{Binding IsMediaPlaceholder}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="8" />
                                        <controls:MediaImage Path="{Binding ResolvedMediaPath}"
                                                             MaxWidth="160"
                                                             MaxHeight="160"
                                                             Stretch="Uniform"
                                                             IsVisible="{Binding IsMediaLoaded}" />
                                      </Panel>
                                    </Border>

                                    <TextBlock Text="{Binding Content}"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               IsVisible="{Binding Type, Converter={StaticResource MessageTypeEqualsConverter}, ConverterParameter=File}" />
                                    <TextBlock Text="{Binding Content}"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               IsVisible="{Binding Type, Converter={StaticResource MessageTypeEqualsConverter}, ConverterParameter=Video}" />
                                    <TextBlock Text="{Binding Content}"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               IsVisible="{Binding Type, Converter={StaticResource MessageTypeEqualsConverter}, ConverterParameter=Voice}" />
                                    <TextBlock Text="{Binding Content}"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               IsVisible="{Binding Type, Converter={StaticResource MessageTypeEqualsConverter}, ConverterParameter=Unknown}" />

                                    <TextBlock Text="{Binding Content}"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               IsVisible="{Binding Type, Converter={StaticResource MessageTypeEqualsConverter}, ConverterParameter=Text}" />
                                    <TextBlock Text="{Binding Content}"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               IsVisible="{Binding Type, Converter={StaticResource MessageTypeEqualsConverter}, ConverterParameter=Quote}" />
                                  </StackPanel>
                                </controls:ChatBubble>
                                <TextBlock Text="📌"
                                           FontSize="11"
                                           Margin="4,0,0,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           IsVisible="{Binding IsPinned}" />
                              </Panel>
                            </StackPanel>
                          </DockPanel>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <!-- Composer -->
                <Border Grid.Row="2"
                        Padding="14"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Background="{DynamicResource PanelElevatedBrush}">
                  <Grid RowDefinitions="Auto,Auto">
                    <Panel>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                        <Button Classes="glass-button"
                                Content="😀"
                                ToolTip.Tip="表情"
                                Command="{Binding ToggleEmojiPickerCommand}" />
                        <Button Classes="glass-button"
                                Content="🖼"
                                ToolTip.Tip="图片"
                                Command="{Binding PickImageCommand}" />
                        <Button Classes="glass-button"
                                Content="📎"
                                ToolTip.Tip="文件"
                                Command="{Binding PickFileCommand}" />
                        <Button Classes="accent-button"
                                Content="✨ AI助手"
                                Command="{Binding ToggleAiAssistantCommand}" />
                      </StackPanel>

                      <!-- Emoji popup -->
                      <Border IsVisible="{Binding IsEmojiPickerOpen}"
                              VerticalAlignment="Bottom"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,52"
                              Padding="10"
                              CornerRadius="12"
                              Background="{DynamicResource PanelBrush}"
                              BorderBrush="{DynamicResource GlassBorderBrush}"
                              BorderThickness="1"
                              BoxShadow="0 8 24 0 #40000000"
                              ZIndex="5">
                        <UniformGrid Columns="8" Width="280">
                          <Button Classes="glass-button" Padding="6" Margin="2"
                                  Content="😀" Command="{Binding InsertEmojiCommand}" CommandParameter="😀" />
                          <Button Classes="glass-button" Padding="6" Margin="2"
                                  Content="😁" Command="{Binding InsertEmojiCommand}" CommandParameter="😁" />
                          <Button Classes="glass-button" Padding="6" Margin="2"
                                  Content="😂" Command="{Binding InsertEmojiCommand}" CommandParameter="😂" />
                          <Button Classes="glass-button" Padding="6" Margin="2"
                                  Content="🤣" Command="{Binding InsertEmojiCommand}" CommandParameter="🤣" />
                          <Button Classes="glass-button" Padding="6" Margin="2"
                                  Content="😊" Command="{Binding InsertEmojiCommand}" CommandParameter="😊" />
                          <Button Classes="glass-button" Padding="6" Margin="2"
                                  Content="😍" Command="{Binding InsertEmojiCommand}" CommandParameter="😍" />
                          <Button Classes="glass-button" Padding="6" Margin="2"
                                  Content="🤔" Command="{Binding InsertEmojiCommand}" CommandParameter="🤔" />
                          <Button Classes="glass-button" Padding="6" Margin="2"
                                  Content="😎" Command="{Binding InsertEmojiCommand}" CommandParameter="😎" />
                          <Button Classes="glass-button" Padding="6" Margin="2"
                                  Content="👍" Command="{Binding InsertEmojiCommand}" CommandParameter="👍" />
                          <Button Classes="glass-button" Padding="6" Margin="2"
                                  Content="👎" Command="{Binding InsertEmojiCommand}" CommandParameter="👎" />
                          <Button Classes="glass-button" Padding="6" Margin="2"
                                  Content="👏" Command="{Binding InsertEmojiCommand}" CommandParameter="👏" />
                          <Button Classes="glass-button" Padding="6" Margin="2"
                                  Content="🙏" Command="{Binding InsertEmojiCommand}" CommandParameter="🙏" />
                          <Button Classes="glass-button" Padding="6" Margin="2"
                                  Content="🔥" Command="{Binding InsertEmojiCommand}" CommandParameter="🔥" />
                          <Button Classes="glass-button" Padding="6" Margin="2"
                                  Content="✨" Command="{Binding InsertEmojiCommand}" CommandParameter="✨" />
                          <Button Classes="glass-button" Padding="6" Margin="2"
                                  Content="🎉" Command="{Binding InsertEmojiCommand}" CommandParameter="🎉" />
                          <Button Classes="glass-button" Padding="6" Margin="2"
                                  Content="❤️" Command="{Binding InsertEmojiCommand}" CommandParameter="❤️" />
                        </UniformGrid>
                      </Border>
                    </Panel>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                      <TextBox Text="{Binding DraftText}"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               MinHeight="72"
                               MaxHeight="140"
                               MinWidth="0"
                               PlaceholderText="输入消息, 按 Enter 发送, Shift + Enter 换行"
                               Background="{DynamicResource InputBackgroundBrush}"
                               Foreground="{DynamicResource TextBrush}"
                               BorderBrush="{DynamicResource GlassBorderBrush}"
                               BorderThickness="1"
                               CornerRadius="12"
                               Padding="12"
                               KeyDown="MessageInput_OnKeyDown" />
                      <Button Grid.Column="1"
                              Classes="accent-button"
                              Margin="10,0,0,0"
                              VerticalAlignment="Bottom"
                              MinWidth="88"
                              Command="{Binding SendCommand}"
                              Content="发送 ✈" />
                    </Grid>
                  </Grid>
                </Border>
              </Grid>
            </controls:GlassCard>

            <!-- Favorites overlay body -->
            <controls:GlassCard ContentPadding="24"
                                IsVisible="{Binding IsFavoritesVisible}">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <TextBlock Text="★"
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="收藏"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="收藏功能将在后续版本提供"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </controls:GlassCard>
          </Grid>

          <!-- Right: AI panel (Auto column collapses when invisible) -->
          <controls:GlassCard Grid.Column="2"
                              Width="340"
                              ContentPadding="14"
                              IsVisible="{Binding IsAiPanelVisible}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" DataContext="{Binding AiPanel}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="✨ AI助手"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                  <Ellipse Width="8" Height="8"
                           Fill="{DynamicResource SuccessBrush}"
                           IsVisible="{Binding IsConnected}" />
                  <TextBlock Text="已连接"
                             FontSize="12"
                             Foreground="{DynamicResource SuccessBrush}"
                             IsVisible="{Binding IsConnected}" />
                  <TextBlock Text="{Binding StatusText}"
                             FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}"
                             IsVisible="{Binding IsGenerating}" />
                  <Button Classes="glass-button"
                          Padding="8,4"
                          Content="连接"
                          IsVisible="{Binding !IsConnected}"
                          Command="{Binding ConnectCommand}" />
                  <Button Classes="glass-button"
                          Padding="8,4"
                          Content="✕"
                          ToolTip.Tip="收起"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CollapseAiPanelCommand}" />
                </StackPanel>
              </Grid>

              <controls:AISettingCard Grid.Row="1" Margin="0,14,0,0">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Text="模型"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="12"
                             VerticalAlignment="Center" />
                  <Border Grid.Column="1"
                          HorizontalAlignment="Right"
                          Padding="10,6"
                          CornerRadius="8"
                          Background="{DynamicResource InputBackgroundBrush}"
                          BorderBrush="{DynamicResource GlassBorderBrush}"
                          BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="🐋" FontSize="14" />
                      <TextBlock Text="{Binding ModelName}"
                                 Foreground="{DynamicResource TextBrush}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Border>
                </Grid>
              </controls:AISettingCard>

              <controls:AISettingCard Grid.Row="2" Margin="0,10,0,0">
                <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="8">
                    <TextBlock Text="模式" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    <Grid ColumnDefinitions="*,*,*">
                      <Button Classes="segment" Classes.active="{Binding IsAutoMode}"
                              Command="{Binding SetReplyModeCommand}" CommandParameter="Auto"
                              Content="自动" HorizontalAlignment="Stretch" FontSize="12" />
                      <Button Grid.Column="1" Classes="segment" Classes.active="{Binding IsManualMode}"
                              Command="{Binding SetReplyModeCommand}" CommandParameter="Manual"
                              Content="确认" HorizontalAlignment="Stretch" FontSize="12" />
                      <Button Grid.Column="2" Classes="segment" Classes.active="{Binding IsOffMode}"
                              Command="{Binding SetReplyModeCommand}" CommandParameter="Off"
                              Content="关闭" HorizontalAlignment="Stretch" FontSize="12" />
                    </Grid>

                    <TextBlock Text="上下文消息" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    <UniformGrid Columns="4">
                      <Button Classes="segment" Margin="1" Classes.active="{Binding IsContext5}"
                              Command="{Binding SetContextLengthCommand}" CommandParameter="5" Content="5" FontSize="12" />
                      <Button Classes="segment" Margin="1" Classes.active="{Binding IsContext10}"
                              Command="{Binding SetContextLengthCommand}" CommandParameter="10" Content="10" FontSize="12" />
                      <Button Classes="segment" Margin="1" Classes.active="{Binding IsContext20}"
                              Command="{Binding SetContextLengthCommand}" CommandParameter="20" Content="20" FontSize="12" />
                      <Button Classes="segment" Margin="1" Classes.active="{Binding IsContext50}"
                              Command="{Binding SetContextLengthCommand}" CommandParameter="50" Content="50" FontSize="12" />
                    </UniformGrid>

                    <Grid ColumnDefinitions="*,Auto" MinWidth="0">
                      <TextBlock Text="参考自己的发言" FontSize="12"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MinWidth="0" />
                      <ToggleSwitch Grid.Column="1" IsChecked="{Binding IncludeOwnMessages}" OnContent="" OffContent="" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" MinWidth="0">
                      <TextBlock Text="收到消息自动生成" FontSize="12" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 VerticalAlignment="Center" MinWidth="0" />
                      <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoGenerateOnReceive}" OnContent="" OffContent="" />
                    </Grid>

                    <TextBox Text="{Binding TemporaryInstruction}"
                             PlaceholderText="本次回复要求（可选）"
                             MinWidth="0"
                             FontSize="12"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource GlassBorderBrush}"
                             BorderThickness="1"
                             CornerRadius="8"
                             Padding="8,6"
                             KeyDown="AiInstruction_OnKeyDown" />
                    <WrapPanel ItemSpacing="6" LineSpacing="6">
                      <Button Classes="glass-button" FontSize="10" Padding="8,3" Content="委婉一点"
                              Command="{Binding ApplyInstructionChipCommand}" CommandParameter="委婉一点" />
                      <Button Classes="glass-button" FontSize="10" Padding="8,3" Content="简短回复"
                              Command="{Binding ApplyInstructionChipCommand}" CommandParameter="简短回复" />
                      <Button Classes="glass-button" FontSize="10" Padding="8,3" Content="更口语"
                              Command="{Binding ApplyInstructionChipCommand}" CommandParameter="更口语" />
                      <Button Classes="glass-button" FontSize="10" Padding="8,3" Content="明确拒绝"
                              Command="{Binding ApplyInstructionChipCommand}" CommandParameter="明确拒绝" />
                    </WrapPanel>

                    <Grid ColumnDefinitions="*,Auto" MinWidth="0">
                      <TextBlock Text="{Binding ContextSummaryText}"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 MinWidth="0"
                                 VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="glass-button" Padding="8,4" FontSize="11"
                              Content="预览"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenAiContextPreviewCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding PinnedCountText}"
                               FontSize="11"
                               Foreground="{DynamicResource AccentBrush}" />

                    <Button Classes="glass-button" HorizontalAlignment="Stretch" Padding="8,6"
                            Content="更多 AI 设置"
                            Command="{Binding ToggleMoreSettingsCommand}" />
                    <StackPanel Spacing="8" IsVisible="{Binding IsMoreSettingsExpanded}">
                      <TextBlock Text="回复风格" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <UniformGrid Columns="2">
                        <Button Classes="segment" Margin="1" Classes.active="{Binding IsStyleNatural}"
                                Command="{Binding SetReplyStyleCommand}" CommandParameter="Natural" Content="自然" FontSize="11" />
                        <Button Classes="segment" Margin="1" Classes.active="{Binding IsStyleConcise}"
                                Command="{Binding SetReplyStyleCommand}" CommandParameter="Concise" Content="简短" FontSize="11" />
                        <Button Classes="segment" Margin="1" Classes.active="{Binding IsStyleFormal}"
                                Command="{Binding SetReplyStyleCommand}" CommandParameter="Formal" Content="正式" FontSize="11" />
                        <Button Classes="segment" Margin="1" Classes.active="{Binding IsStyleHumorous}"
                                Command="{Binding SetReplyStyleCommand}" CommandParameter="Humorous" Content="幽默" FontSize="11" />
                      </UniformGrid>
                      <TextBlock Text="回复长度" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <Grid ColumnDefinitions="*,*,*">
                        <Button Classes="segment" Classes.active="{Binding IsLengthShort}"
                                Command="{Binding SetReplyLengthCommand}" CommandParameter="Short" Content="短" FontSize="11" />
                        <Button Grid.Column="1" Classes="segment" Classes.active="{Binding IsLengthMedium}"
                                Command="{Binding SetReplyLengthCommand}" CommandParameter="Medium" Content="中" FontSize="11" />
                        <Button Grid.Column="2" Classes="segment" Classes.active="{Binding IsLengthLong}"
                                Command="{Binding SetReplyLengthCommand}" CommandParameter="Long" Content="长" FontSize="11" />
                      </Grid>
                      <TextBlock Text="群聊触发" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <Grid ColumnDefinitions="*,*,*">
                        <Button Classes="segment" Classes.active="{Binding IsTriggerMentionOrQuote}"
                                Command="{Binding SetGroupTriggerCommand}" CommandParameter="MentionOrQuoteMe"
                                Content="@/引用" FontSize="10" ToolTip.Tip="仅 @我 或引用我" />
                        <Button Grid.Column="1" Classes="segment" Classes.active="{Binding IsTriggerAll}"
                                Command="{Binding SetGroupTriggerCommand}" CommandParameter="AllMessages"
                                Content="全部" FontSize="10" />
                        <Button Grid.Column="2" Classes="segment" Classes.active="{Binding IsTriggerOff}"
                                Command="{Binding SetGroupTriggerCommand}" CommandParameter="Off"
                                Content="关闭" FontSize="10" />
                      </Grid>
                      <Button Classes="glass-button" HorizontalAlignment="Stretch"
                              Content="恢复全局默认"
                              Command="{Binding RestoreGlobalDefaultsCommand}"
                              IsVisible="{Binding IsUsingContactOverride}" />
                      <StackPanel Spacing="4" IsVisible="{Binding IsAutoMode}">
                        <Button Classes="glass-button" HorizontalAlignment="Stretch"
                                Content="暂停全部自动回复 30 分钟"
                                Command="{Binding PauseAutoMinutesCommand}" CommandParameter="30"
                                IsVisible="{Binding !IsAutoPaused}" />
                        <Button Classes="glass-button" HorizontalAlignment="Stretch"
                                Content="恢复自动回复"
                                Command="{Binding ResumeAutoCommand}"
                                IsVisible="{Binding IsAutoPaused}" />
                      </StackPanel>
                      <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                 IsVisible="{Binding IsUsingContactOverride}"
                                 Text="当前：本聊天独立设置" />
                      <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                 IsVisible="{Binding !IsUsingContactOverride}"
                                 Text="当前：全局默认设置" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </controls:AISettingCard>

              <TextBlock Grid.Row="3"
                         Text="回复历史"
                         FontWeight="SemiBold"
                         Margin="0,14,0,8"
                         Foreground="{DynamicResource TextBrush}" />

              <ScrollViewer Grid.Row="4">
                <StackPanel Spacing="8">
                  <Border IsVisible="{Binding IsGenerating}"
                          Background="{DynamicResource PanelElevatedBrush}"
                          BorderBrush="{DynamicResource GlassBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="12">
                    <TextBlock Text="{Binding TypingPreview}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13" />
                  </Border>
                  <ItemsControl ItemsSource="{Binding ReplyHistory}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:AIReplyHistoryItem">
                        <Border Background="{DynamicResource PanelElevatedBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0,0,0,8">
                          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" MinWidth="0">
                              <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         FontSize="11" />
                              <Border Background="{DynamicResource SelectedOverlayBrush}"
                                      CornerRadius="6"
                                      Padding="6,2">
                                <TextBlock Text="{Binding Status}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}" />
                              </Border>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="glass-button"
                                    Padding="8,4"
                                    Content="复制"
                                    Command="{Binding $parent[ItemsControl].((vm:AIPanelViewModel)DataContext).CopyReplyCommand}"
                                    CommandParameter="{Binding}" />
                            <TextBlock Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Margin="0,8,0,0"
                                       Text="{Binding Content}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="13" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>

              <StackPanel Grid.Row="5" Spacing="8" Margin="0,10,0,0">
                <Button Classes="accent-button"
                        HorizontalAlignment="Stretch"
                        Content="停止生成"
                        IsVisible="{Binding IsGenerating}"
                        Command="{Binding CancelGenerationCommand}" />
                <Button Classes="accent-button"
                        HorizontalAlignment="Stretch"
                        Content="按原上下文重试"
                        IsVisible="{Binding !IsGenerating}"
                        Command="{Binding RegenerateSameContextCommand}" />
                <Button Classes="glass-button"
                        HorizontalAlignment="Stretch"
                        Content="使用最新上下文重新生成"
                        IsVisible="{Binding !IsGenerating}"
                        Command="{Binding RegenerateFreshContextCommand}" />
                <Button Classes="glass-button"
                        HorizontalAlignment="Stretch"
                        Content="清空历史"
                        Command="{Binding ClearHistoryCommand}" />
                <Button Classes="glass-button"
                        HorizontalAlignment="Stretch"
                        Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AiPanelToggleText}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleAiPanelCommand}" />
              </StackPanel>
            </Grid>
          </controls:GlassCard>

          <!-- Context preview overlay -->
          <Grid Grid.ColumnSpan="3"
                IsVisible="{Binding AiPanel.IsContextPreviewOpen}"
                ZIndex="25">
            <Border Background="#99000000"
                    PointerPressed="ContextPreviewMask_OnPointerPressed" />
            <Border Width="420" MaxHeight="560"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,24,0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16"
                    DataContext="{Binding AiPanel}">
              <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="上下文预览" FontWeight="SemiBold" FontSize="15"
                             Foreground="{DynamicResource TextBrush}" />
                  <Button Grid.Column="1" Classes="glass-button" Content="✕"
                          Command="{Binding ToggleContextPreviewCommand}" />
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding ContextSummaryText}" FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding TokenEstimateText}" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="glass-button" Content="全选" FontSize="11"
                              Command="{Binding SelectAllPreviewCommand}" />
                      <Button Classes="glass-button" Content="恢复默认" FontSize="11"
                              Command="{Binding ResetPreviewExclusionsCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding TemporaryInstruction, StringFormat=临时要求：{0}}"
                               IsVisible="{Binding TemporaryInstruction, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentBrush}" />
                    <ItemsControl ItemsSource="{Binding PreviewMessages}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:AIContextMessage">
                          <Border Background="{DynamicResource PanelElevatedBrush}"
                                  CornerRadius="8" Padding="10" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                              <CheckBox VerticalAlignment="Top"
                                        IsChecked="{Binding IsIncludedInRequest, Mode=OneWay}"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AiPanel.ToggleExcludeCommand}"
                                        CommandParameter="{Binding MessageId}" />
                              <StackPanel Grid.Column="1" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Text="{Binding Role}" FontSize="10"
                                             Foreground="{DynamicResource AccentBrush}" />
                                  <TextBlock Text="{Binding Source}" FontSize="10"
                                             Foreground="{DynamicResource TextMutedBrush}" />
                                  <TextBlock Text="📌" FontSize="10" IsVisible="{Binding IsPinned}" />
                                  <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}" FontSize="10"
                                             Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="12"
                                           MaxHeight="72" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextBrush}" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="2" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="预览与真实 API payload 同源（临时排除仅本次）" />
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- Toast banner -->
        <Border VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                Padding="16,10"
                CornerRadius="10"
                Background="{DynamicResource PanelElevatedBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1"
                BoxShadow="0 8 20 0 #40000000"
                IsVisible="{Binding IsToastVisible}"
                ZIndex="30">
          <TextBlock Text="{Binding ToastMessage}"
                     Foreground="{DynamicResource TextBrush}"
                     FontSize="13"
                     TextWrapping="Wrap"
                     MaxWidth="420" />
        </Border>

        <!-- Settings drawer -->
        <Grid IsVisible="{Binding IsSettingsOpen}" ZIndex="40">
          <Border Background="#99000000"
                  PointerPressed="SettingsMask_OnPointerPressed" />
          <Border Width="360"
                  MaxWidth="360"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource GlassBorderBrush}"
                  BorderThickness="1,0,0,0"
                  Padding="20">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="设置"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" />
                <Button Grid.Column="1"
                        Classes="glass-button"
                        Content="✕"
                        Command="{Binding CloseSettingsCommand}" />
              </Grid>
              <ScrollViewer Grid.Row="1" Margin="0,24,0,0">
                <StackPanel Spacing="12">
                  <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8" />

                  <TextBlock Text="微信接入"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextBrush}" />
                  <TextBlock Text="{Binding WechatStatusText}"
                             FontSize="12"
                             Foreground="{DynamicResource TextMutedBrush}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="segment"
                            Classes.active="{Binding IsWechatProviderMock}"
                            Command="{Binding SetWechatProviderCommand}"
                            CommandParameter="Mock"
                            Content="Mock" />
                    <Button Classes="segment"
                            Classes.active="{Binding IsWechatProviderReal}"
                            Command="{Binding SetWechatProviderCommand}"
                            CommandParameter="Real"
                            Content="真实 Hook" />
                    <Button Classes="glass-button"
                            Content="重新连接"
                            Command="{Binding ReconnectWechatCommand}" />
                  </StackPanel>
                  <TextBlock Text="本地 Hook API：127.0.0.1:19088 · 回调 5000/61108"
                             FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}" />
                  <TextBlock Text="第三方 inject 需自行按命令行参数启动；App 只检测 API 在线。"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource TextMutedBrush}" />

                  <TextBlock Text="微信账号连接"
                             FontWeight="SemiBold"
                             Margin="0,12,0,0"
                             Foreground="{DynamicResource TextBrush}" />
                  <ItemsControl ItemsSource="{Binding AccountProfileCards}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AccountProfileCardItem">
                        <Border Margin="0,0,0,8"
                                Padding="12"
                                CornerRadius="10"
                                Background="{DynamicResource QuoteBackgroundBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1">
                          <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Title}"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextBrush}"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding StatusText}"
                                         FontSize="11"
                                         Foreground="{DynamicResource TextMutedBrush}" />
                            </Grid>
                            <TextBlock Text="{Binding PortsText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Wxid}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       IsVisible="{Binding Wxid, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Button Classes="glass-button"
                                      Content="编辑"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BeginEditAccountProfileCommand}"
                                      CommandParameter="{Binding}" />
                              <Button Classes="glass-button"
                                      Content="{Binding ToggleEnabledLabel}"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleAccountProfileEnabledCommand}"
                                      CommandParameter="{Binding}" />
                              <Button Classes="glass-button"
                                      Content="删除"
                                      IsVisible="{Binding CanDelete}"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteAccountProfileCommand}"
                                      CommandParameter="{Binding}" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Classes="glass-button"
                          Content="+ 添加账号"
                          HorizontalAlignment="Stretch"
                          Command="{Binding BeginAddAccountProfileCommand}" />
                  <Border IsVisible="{Binding IsEditingAccountProfile}"
                          Margin="0,4,0,0"
                          Padding="12"
                          CornerRadius="10"
                          Background="{DynamicResource QuoteBackgroundBrush}"
                          BorderBrush="{DynamicResource AccentBrush}"
                          BorderThickness="1">
                    <StackPanel Spacing="8">
                      <TextBlock Text="编辑账号配置"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextBrush}" />
                      <TextBox Watermark="显示名称"
                               Text="{Binding EditProfileDisplayName}" />
                      <TextBox Watermark="BaseUrl"
                               Text="{Binding EditProfileBaseUrl}" />
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <TextBox Watermark="HTTP 回调端口"
                                 Text="{Binding EditProfileHttpPort}" />
                        <TextBox Grid.Column="1"
                                 Watermark="TCP 回调端口"
                                 Text="{Binding EditProfileTcpPort}" />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="glass-button"
                                Content="保存"
                                Command="{Binding SaveAccountProfileCommand}" />
                        <Button Classes="glass-button"
                                Content="取消"
                                Command="{Binding CancelEditAccountProfileCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8" />

                  <TextBlock Text="主题"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Button Classes="segment"
                          HorizontalAlignment="Stretch"
                          Classes.active="{Binding IsDarkTheme}"
                          Command="{Binding SetThemeCommand}"
                          CommandParameter="Dark"
                          Content="○ 深色模式" />
                  <Button Classes="segment"
                          HorizontalAlignment="Stretch"
                          Classes.active="{Binding IsLightTheme}"
                          Command="{Binding SetThemeCommand}"
                          CommandParameter="Light"
                          Content="○ 浅色模式" />
                  <Button Classes="segment"
                          HorizontalAlignment="Stretch"
                          Classes.active="{Binding IsSystemTheme}"
                          Command="{Binding SetThemeCommand}"
                          CommandParameter="System"
                          Content="○ 跟随系统" />

                  <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8" />

                  <TextBlock Text="AI 服务"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextBrush}" />
                  <TextBlock Text="提供商"
                             FontSize="12"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="segment"
                            Classes.active="{Binding IsProviderMock}"
                            Command="{Binding SetAiProviderCommand}"
                            CommandParameter="Mock"
                            Content="Mock" />
                    <Button Classes="segment"
                            Classes.active="{Binding IsProviderDeepSeek}"
                            Command="{Binding SetAiProviderCommand}"
                            CommandParameter="DeepSeek"
                            Content="DeepSeek" />
                  </StackPanel>

                  <TextBlock Text="模型"
                             FontSize="12"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <ComboBox ItemsSource="{Binding AvailableAiModels}"
                            SelectedValue="{Binding SettingsAiModelId}"
                            SelectedValueBinding="{Binding Id}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="models:AIModelDescriptor">
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <TextBlock Text="API Key"
                             FontSize="12"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Grid ColumnDefinitions="*,Auto">
                    <Panel>
                      <TextBox Text="{Binding SettingsApiKey}"
                               PasswordChar="*"
                               PlaceholderText="sk-..."
                               IsVisible="{Binding !SettingsShowApiKey}" />
                      <TextBox Text="{Binding SettingsApiKey}"
                               PlaceholderText="sk-..."
                               IsVisible="{Binding SettingsShowApiKey}" />
                    </Panel>
                    <Button Grid.Column="1"
                            Classes="glass-button"
                            Margin="8,0,0,0"
                            Content="显示"
                            Command="{Binding ToggleShowApiKeyCommand}" />
                  </Grid>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="glass-button"
                            Content="测试连接"
                            Command="{Binding TestAiConnectionCommand}"
                            IsEnabled="{Binding !IsTestingConnection}" />
                    <Button Classes="glass-button"
                            Content="保存"
                            Command="{Binding SaveAiProviderSettingsCommand}" />
                    <Button Classes="glass-button"
                            Content="清除 Key"
                            Command="{Binding ClearApiKeyCommand}" />
                  </StackPanel>
                  <TextBlock Text="{Binding SettingsConnectionMessage}"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource TextMutedBrush}" />

                  <Button Classes="glass-button"
                          HorizontalAlignment="Left"
                          Content="高级选项 ▾"
                          Command="{Binding ToggleAiAdvancedCommand}" />
                  <StackPanel Spacing="8" IsVisible="{Binding IsAiAdvancedExpanded}">
                    <TextBlock Text="Base URL" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding SettingsBaseUrl}" />
                    <TextBlock Text="超时（秒）" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <NumericUpDown Value="{Binding SettingsTimeoutSeconds}" Minimum="5" Maximum="300" />
                    <TextBlock Text="Max Tokens" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <NumericUpDown Value="{Binding SettingsMaxTokens}" Minimum="16" Maximum="8192" />
                    <TextBlock Text="Temperature" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <NumericUpDown Value="{Binding SettingsTemperature}" Minimum="0" Maximum="2" Increment="0.1" FormatString="0.0" />
                    <CheckBox IsChecked="{Binding SettingsStreaming}" Content="启用流式输出" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
              <TextBlock Grid.Row="2"
                         Text="WechatAIClient"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="11"
                         HorizontalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
